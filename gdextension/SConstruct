# SConstruct — godot-cpp build for the Insimul GDExtension.
#
# Standard godot-cpp SCons flow. Requires the godot-cpp submodule at ./godot-cpp
# (see THIRD_PARTY.md for the pin) and libinsimul headers+libs from
# insimul-native/dist (see vendor/insimul/insimul.h contract). Neither is present
# in the Ralph harness, so this file is the *build contract*; the host marshalling
# tests (test/run_host_tests.sh) are what actually run here.
#
# Usage (in a full toolchain):
#   git submodule add https://github.com/godotengine/godot-cpp godot-cpp
#   (cd godot-cpp && git checkout godot-4.2-stable)
#   scons target=template_debug
#
# Output: bin/libinsimul_godot.<platform>.<target>[.<arch>].<ext>

import os

env = SConscript("godot-cpp/SConstruct")

# libinsimul consumption (per insimul-native/docs/consuming.md). Override with
# INSIMUL_NATIVE_DIST to point at a built dist/<platform>/ directory.
insimul_dist = os.environ.get("INSIMUL_NATIVE_DIST", "vendor/insimul")
env.Append(CPPPATH=["src/", insimul_dist])
if os.path.isdir(os.path.join(insimul_dist, "lib")):
    env.Append(LIBPATH=[os.path.join(insimul_dist, "lib")])
    env.Append(LIBS=["insimul"])

# libinsimulcore (corebridge/): `@insimul/core` running in an embedded QuickJS
# behind the insimulcore.h C ABI — see corebridge/README.md and
# RUNTIME_CORE_ADOPTION.md §4.5. Vendored third-party C is compiled with warnings
# off; it is not ours to lint, and QuickJS is warning-noisy by design.
quickjs_version = open("corebridge/vendor/quickjs/VERSION").read().strip()
bridge_env = env.Clone()
bridge_env.Append(CPPPATH=[
    "corebridge/include", "corebridge/vendor/quickjs", "corebridge/vendor/core", insimul_dist,
])
bridge_env.Append(CPPDEFINES=[("CONFIG_VERSION", '\\"%s\\"' % quickjs_version)])

vendor_env = bridge_env.Clone()
vendor_env.Append(CCFLAGS=["/w"] if env.get("is_msvc") else ["-w"])

corebridge_objects = [
    vendor_env.SharedObject(source)
    for source in Glob("corebridge/vendor/quickjs/*.c") + Glob("corebridge/vendor/core/*.c")
] + [
    bridge_env.SharedObject(source) for source in Glob("corebridge/src/*.c")
]

# src/insimul_core.cpp includes the ABI header by relative path, so only the
# vendored-bundle include dir has to reach the C++ side.
env.Append(CPPPATH=["corebridge/include"])

sources = Glob("src/*.cpp") + corebridge_objects

if env["platform"] == "macos":
    library = env.SharedLibrary(
        "bin/libinsimul_godot.{}.{}.framework/libinsimul_godot.{}.{}".format(
            env["platform"], env["target"], env["platform"], env["target"]
        ),
        source=sources,
    )
else:
    library = env.SharedLibrary(
        "bin/libinsimul_godot{}{}".format(env["suffix"], env["SHLIBSUFFIX"]),
        source=sources,
    )

Default(library)
