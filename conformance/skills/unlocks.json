        "actor": "wren",
        "node": {
          "parents": [
            "true_chisel"
          ],
          "requires": [],
          "effects": [
            {
              "kind": "unlocks",
              "args": [
                "set_keystone"
              ]
            },
            {
              "kind": "modifies",
              "args": [
                "damage",
                1
              ]
            }
          ],
          "id": "keystone_sense",
          "tree": "stonework",
          "name": "Keystone Sense",
          "cost": 2
        },
        "points": 3,
        "unlocked": false,
        "tuning": {
          "pointsPerLevel": 1,
          "defaultNodeCost": 1,
          "defaultMaxLevel": 10,
          "levelXp": [
            0,
            0,
            100,
            250,
            450,
            700,
            1000,
            1350,
            1750,
            2200,
            2700
          ],
          "advanceAction": "train_skill",
          "unlockAction": "unlock_skill_node"
        }
      },
      "expected": {
        "resolution": {
          "actor": "wren",
          "node": "keystone_sense",
          "tree": "stonework",
          "points": 3,
          "action": "unlock_skill_node",
          "cost": 2,
          "requires": [
            "skill_unlocked(Actor, true_chisel)"
          ],
          "conditional": true,
          "available": true
        },
        "requirements": [
          "skill_unlocked(Actor, true_chisel)"
        ],
        "cost": 2
      }
    },
    {
