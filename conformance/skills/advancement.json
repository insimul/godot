{
  "area": "skills-advancement",
  "description": "What a level PRICES and whether an actor may take it (US-3 of `123-skill-trees-and-progression`), pinned so four engines read one save the same way. Each case carries the whole input — the authored skill with its own curve and cap, the actor’s level, their banked XP, every level they hold for the `skill_requires/3` check, and the fully resolved SkillTuning — so a harness in any language reproduces it with no defaults table, no world file and no KB. `expected.curve` is what every level from 0 to one past the cap prices, read out of `skill_level_xp/3`: a PRICE and never a running total, because a save’s bank is what is UNSPENT and that reading stays true when a creator retunes the curve. Level 1 is priced like any other level, so a world can charge for an apprenticeship without a second mechanism, and a level past the end of the curve repeats the last entry rather than becoming free. `expected.resolution.refusal` is evaluated in SKILL_ADVANCE_REFUSALS order — unknown, prerequisite, capped, xp — and `forbidden` NEVER appears here: permissibility is `forbids/4`’s and a pure function may not call a KB, so a corpus that pinned one would be pinning a guess. Regenerate with `npm run skill-resolution-corpus`.",
  "cases": [
    {
      "name": "learning-a-skill-is-advancing-from-zero",
      "note": "THE case the design turns on. Level 1 is priced like any other level — `curve[1]`, which this world sets to 0 — so learning is gated by the skill’s `skill_requires/3` prerequisites and not by a bank. A port with a separate “learn” entry point has two answers to one question.",
      "input": {
        "actor": "wren",
        "skill": {
          "id": "masonry",
          "category": "craft",
          "maxLevel": 4,
          "levelXp": [
            0,
            0,
            40,
            120,
            300
          ],
          "requires": []
        },
        "level": 0,
        "banked": 0,
        "levels": {},
        "tuning": {
          "pointsPerLevel": 1,
          "defaultNodeCost": 1,
          "defaultMaxLevel": 10,
          "levelXp": [
            0,
            0,
            100,
            250,
            450,
            700,
            1000,
            1350,
            1750,
            2200,
            2700
          ],
          "advanceAction": "train_skill",
          "unlockAction": "unlock_skill_node"
        }
      },
      "expected": {
        "resolution": {
          "actor": "wren",
          "skill": "masonry",
          "level": 0,
          "next": 1,
          "price": 0,
          "banked": 0,
          "action": "train_skill",
          "available": true
        },
        "curve": [
          0,
          0,
          40,
          120,
          300,
          300
        ],
        "maxLevel": 4
      }
    },
