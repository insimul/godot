{
  "area": "items-pricing",
  "description": "What a thing costs HERE, from whom, and why (US-2 and US-4 of `124-items-equipment-economy`). This is the file that says Insimul does not need a shop table: a price is a function of the simulation that already exists — `vendor_markup/2` of the business, `container_contains/3` on the vendor’s own shelf against `item_stock_normal/2`, `reputation/3` with the faction the shop answers to, and `business_owner/2` — and every term is reported with the percentage and the coin it moved, because a player charged double is owed the reason. The corpus’s own teeth are two cases: the same sword, the same shop, the same shelf, two buyers, two prices, differing only by a fact the KB already held; and a world with no economy at all, where the price IS `item_value/2` and `fallback` says so. Terms are summed against the AUTHORED base rather than compounded, so term order cannot make two engines disagree, and every percentage is applied per unit with the quantity multiplied last. Regenerate with `npm run items-corpus`.",
  "cases": [
    {
      "name": "a-stranger-pays-the-smithy’s-margin",
      "note": "The baseline every other case differs from: `vendor_markup/2` of the business this vendor trades for, and nothing else, because the shelf is stocked and the KB knows nothing about this buyer. The term names the business it came from.",
      "input": {
        "actor": "wren",
        "direction": "buy",
        "quantity": 1,
        "market": {
          "vendor": {
            "id": "hilde",
            "business": "ironmongers",
            "markupPercent": 20,
            "goldReserve": 300,
            "dealsIn": [
              "steel"
            ],
            "stockSize": 2
          },
          "owner": "tomas",
          "faction": "town_watch",
          "stock": 4
        },
        "tuning": {
          "markupPercent": 10,
          "sellMarginPercent": 80,
          "scarcityPercent": 50,
          "stockNormal": 0,
          "standingPercent": 25,
          "standingScale": 100,
          "proprietorPercent": 30,
          "minimumPrice": 1,
          "buyAction": "buy_item",
          "sellAction": "sell_item",
          "stockSize": 2,
          "stockDepth": 4
        },
        "item": {
          "itemType": "weapon",
          "weight": 8,
          "value": 100,
          "sellValue": 50,
          "tradeable": true,
          "stackable": false,
          "maxStack": 1,
          "tags": [
            "steel",
            "weapon"
          ],
          "effects": {
            "attack": 3
          },
          "requires": [],
          "lootWeight": 3,
          "id": "steel_sword",
          "name": "Steel Sword",
          "equipSlot": "weapon"
        }
      },
      "expected": {
        "price": {
          "item": "steel_sword",
          "direction": "buy",
          "base": 100,
          "adjustments": [
            {
              "factor": "markup",
              "percent": 20,
              "amount": 20,
              "subject": "ironmongers"
            }
          ],
          "unit": 120,
          "quantity": 1,
          "total": 120,
          "fallback": false
        }
      }
    },
