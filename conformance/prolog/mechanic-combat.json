        ":- dynamic(item_damage_type/2).",
        "hostile_to(A, B) :- faction(A, FA), faction(B, FB), faction_stance(FA, FB, hostile).",
        "can_attack(A, T) :- alive(T), \\+ incapacitated(T), hostile_to(A, T).",
        "in_reach(A, T, W) :- has_equipped(A, weapon, W), item_range(W, R), near(A, T, R).",
        "effective_against(W, T) :- item_damage_type(W, DT), \\+ resists_damage(T, DT).",
        "faction(guard, town_watch).",
        "faction(watchman, town_watch).",
        "faction(bandit, outlaws).",
        "faction(revenant, undead).",
        "faction_stance(town_watch, outlaws, hostile).",
