{
  "area": "radiant-single-slot",
  "description": "Single-slot radiant fills: one candidate is deterministic regardless of seed; multiple candidates are canonically sorted then chosen by the seeded RNG, so the seed selects which candidate wins.",
  "cases": [
    {
      "name": "single-slot-fill-one-candidate",
      "kb": [
        ":- dynamic(radiant_generated/3).",
        ":- dynamic(radiant_cooldown_until/2).",
        "threat_species(wolves)."
      ],
      "templates": [
        "radiant_template(rt_bounty, [category(bounty), title('Cull the {target}'), quest_type(bounty), difficulty(3)]).",
        "radiant_precondition(rt_bounty, target, threat_species(Target)).",
        "radiant_objective(rt_bounty, defeat(Target, 4)).",
        "radiant_reward(rt_bounty, gold, per(target, 15)).",
        "radiant_reward(rt_bounty, experience, times(10, difficulty)).",
        "radiant_cooldown(rt_bounty, 7200)."
      ],
      "seed": "contract",
      "now": 1000,
      "expected": {
        "quests": [
          {
            "questId": "radiant_rt_bounty_1000",
            "templateId": "rt_bounty",
            "content": [
              "quest(radiant_rt_bounty_1000, 'Cull the wolves', bounty, 3, available).",
              "quest_objective(radiant_rt_bounty_1000, 0, defeat(wolves, 4)).",
              "quest_reward(radiant_rt_bounty_1000, experience, 30).",
              "quest_reward(radiant_rt_bounty_1000, gold, 60)."
            ],
            "factsToAssert": [
              "radiant_cooldown_until(rt_bounty, 8200).",
              "radiant_generated(radiant_rt_bounty_1000, rt_bounty, 1000)."
            ],
            "factsToRetract": []
          }
        ]
      }
    },
    {
      "name": "single-slot-fill-multi-candidate",
      "kb": [
        ":- dynamic(radiant_generated/3).",
