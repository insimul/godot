                  "endHour": 18,
                  "place": "forge",
                  "priority": 60
                },
                {
                  "id": "supper",
                  "goal": "eat",
                  "startHour": 18,
                  "endHour": 20,
                  "place": "tavern",
                  "priority": 45
                },
                {
                  "id": "market_day",
                  "goal": "shop",
                  "startHour": 10,
                  "endHour": 12,
                  "days": [
                    5
                  ],
                  "place": "market",
                  "priority": 70
                },
                {
                  "id": "night",
                  "goal": "sleep",
                  "startHour": 22,
                  "endHour": 6,
                  "place": "cottage"
                }
              ]
            },
            {
              "id": "night_watch",
